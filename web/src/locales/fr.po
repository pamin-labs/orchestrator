msgstr "Largeur du parcours"

msgid "Wants a count: 8M, 200k, 45 all work"
msgstr "Attend un nombre : 8M, 200k, 45 fonctionnent"

msgid "Wants a duration: 20 min, 45s, 3 hr all work"
msgstr "Attend une durée : 20 min, 45s, 3 hr fonctionnent"

msgid "Wants a duration: 24 hr, 30 min both work"
msgstr "Attend une durée : 24 hr et 30 min fonctionnent"

msgid "Wants a percentage between 0 and 100, like 60%"
msgstr "Attend un pourcentage entre 0 et 100, par exemple 60 %"

msgid "Was connected, but GitHub no longer recognizes this token"
msgstr "Était connecté, mais GitHub ne reconnaît plus ce token"

