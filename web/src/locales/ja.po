msgstr "{hint} を保存済み。差し替えるには新しい値を貼り付けてください"

msgid "{hitCount} requirements want the same files and cannot run together"
msgstr "{hitCount} 件の要件が同じファイルを取り合うため同時に走れません"

msgid "{hours} hr"
msgstr "{hours} 時間"

msgid "{idleCount} more are idle and costing nothing."
msgstr "他 {idleCount} 件はアイドルで費用ゼロです。"

msgid "{lines} lines"
msgstr "{lines} 行"

