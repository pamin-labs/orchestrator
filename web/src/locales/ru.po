msgstr "уже потрачено {tokens} токенов"

msgid "An unfinished turn is wasted; the group restarts its container and carries on by itself. Code and branches are unaffected."
msgstr "Незавершённый ход пропадает; группа перезапускает контейнер и продолжает сама. Код и ветки не затрагиваются."

msgid "Answered on your behalf"
msgstr "Отвечено за вас"

msgid "answered on your behalf by {who}"
msgstr "за вас ответил {who}"

