msgstr "Не определить, пока первая группа не склонирует; настройки заполните позже"

msgid "Can't read log"
msgstr "Лог не читается"

msgid "Can't read remote branches; storing what you entered"
msgstr "Удалённые ветки не читаются; сохраняем то, что вы ввели"

msgid "Cancel"
msgstr "Отмена"

msgid "Cancel all queued turns; return the occupied slot to another group."
msgstr "Отменяет все ходы в очереди и возвращает занятый слот другой группе."

msgid "Cancel all queued turns; return the occupied slot to another group. Code, branch, and records are kept."
msgstr "Отменяет все ходы в очереди и возвращает занятый слот другой группе. Код, ветка и записи сохраняются."

msgid "Cannot reach the usage endpoint"
msgstr "Не удаётся достучаться до эндпоинта расхода"

msgid "cards pending review"
msgstr "карточек на проверку"

msgid "Change base branch"
msgstr "Сменить базовую ветку"

msgid "Change its access"
msgstr "Изменить доступ"

msgid "Changed to {next}"
msgstr "Изменено на {next}"

msgid "Changes exceed 400k characters; tail not retrieved. Remaining changes are in the sandbox checkout."
msgstr "Изменения превышают 400k символов; конец не получен. Остальное — в чекауте песочницы."

msgid "Check for stuck turns"
msgstr "Проверка зависших ходов"

msgid "Check runs"
msgstr "Проверки"

msgid "Checked skills copy here, read-only mounted to each sandbox. Changes here need sync to sandbox server's allowed_host_paths or container launch fails—loud failure beats silent empty mount."
msgstr "Отмеченные навыки копируются сюда и монтируются в каждую песочницу только для чтения. Изменения здесь нужно согласовать с allowed_host_paths сервера песочниц, иначе контейнер не запустится — громкий отказ лучше тихого пустого монтирования."

msgid "Choose account"
msgstr "Выбрать аккаунт"

msgid "Choose attachments"
msgstr "Выбрать вложения"

msgid "Choose repository"
msgstr "Выбрать репозиторий"

msgid "Claim task"
msgstr "Взять задачу"

msgid "Claude Code writes this in Co-Authored-By when committing"
msgstr "Claude Code пишет это в Co-Authored-By при коммите"

msgid "Clear"
msgstr "Очистить"

