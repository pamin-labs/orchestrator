{
  "name": "orchestrator",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:web && bun run server",
    "start": "bun run dev",
    "server": "bun run src/composition/server.ts",
    "trace:up": "docker compose -f docker/otel-compose.yml up -d",
    "trace:down": "docker compose -f docker/otel-compose.yml down",
    "dev:trace": "OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318 bun run dev",
    "orch": "bun run src/orch/cli.ts",
    "build:web": "bun build web/src/app/main.tsx --outdir web/dist --minify --target browser && tailwindcss -i web/style.css -o web/dist/app.css --minify",
    "perf:budget": "bun run scripts/performance-budget.ts",
    "perf:bench": "bun run scripts/benchmark.ts",
    "embedding:check": "bun run scripts/embedding-check.ts",
    "test": "bun test --parallel",
    "test:changed": "bun test --parallel --changed",
    "test:coverage": "rm -rf coverage/parts && ORCH_COVERAGE=1 bun test --parallel && bun run test/support/coverage-report.ts",
    "typecheck": "tsc -b --pretty false",
    "typecheck:clean": "tsc -b --clean && tsc -b --pretty false",
    "lint": "oxlint src web/src test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "audit": "fallow audit",
    "audit:all": "fallow audit --gate all",
    "audit:crap": "bun run test:coverage && fallow audit --gate all --coverage coverage/coverage-final.json",
    "guard": "fallow guard",
    "health:gaps": "fallow health --coverage-gaps",
    "audit:fix": "fallow fix --yes --no-create-config --format compact",
    "validate": "bun run format:check && bun run typecheck && bun run lint && bun run build:web && bun run perf:budget && bun run test",
    "test:stress": "bun run scripts/stress-tests.ts",
    "check": "bun run audit && bun run validate",
    "preflight": "bun run scripts/preflight.ts",
    "test:coverage:ci": "rm -rf coverage/parts && ORCH_COVERAGE=1 bun test --parallel --reporter=junit --reporter-outfile=\"$JUNIT_OUT\" && bun run test/support/coverage-report.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@electric-sql/pglite": "^0.5.5",
    "@happy-dom/global-registrator": "^20.11.2",
    "@opentelemetry/otlp-transformer": "^0.221.0",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "latest",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/diff": "^8.0.0",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-reports": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/stopword": "^2.0.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "1.0.0-rc.4",
    "fallow": "3.17.0",
    "fast-check": "^4.9.0",
    "fishery": "^2.4.0",
    "happy-dom": "^20.11.2",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "msw": "^2.15.0",
    "oxc-coverage-instrument": "0.12.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "tempy": "^3.2.0",
    "tinybench": "^6.1.3",
    "typescript": "^7"
  },
  "dependencies": {
    "@alibaba-group/opensandbox": "^0.1.11",
    "@hono/zod-validator": "^0.9.0",
    "@octokit/core": "^7.0.7",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-prometheus": "^0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@orama/orama": "^3.1.18",
    "@orama/stemmers": "^3.1.18",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.101.4",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "commander": "^15.0.0",
    "consola": "^3.4.2",
    "croner": "^10.0.1",
    "d3-flame-graph": "^5.0.0",
    "d3-scale": "4.0.2",
    "defu": "^6.1.7",
    "diff": "^9.0.0",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.2",
    "lucide-react": "^1.31.0",
    "p-map": "^7.0.6",
    "parse-diff": "^0.12.0",
    "quick-lru": "^7.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.3",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sonner": "^2.0.8",
    "stopword": "^3.1.5",
    "tailwind-merge": "^3.6.0",
    "unified": "^11.0.5",
    "web-tree-sitter": "0.26.12",
    "zod": "^4.4.3"
  }
}
