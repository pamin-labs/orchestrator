{
  "name": "orchestrator",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run build:web && bun run src/server.ts",
    "orch": "bun run src/orch/cli.ts",
    "test": "bun test test/",
    "audit": "fallow audit --dead-code-baseline .fallow/dead-code.json --health-baseline .fallow/health.json --dupes-baseline .fallow/dupes.json",
    "audit:fix": "fallow fix --type-aware --dry-run --no-create-config --format compact",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "build:web": "bun build web/src/main.tsx --outdir web/dist --minify --target browser && tailwindcss -i web/style.css -o web/dist/app.css --minify",
    "dev": "bun run build:web && bun run src/server.ts",
    "server": "bun run src/server.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@standard-schema/spec": "^1.1.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "latest",
    "@types/diff": "^8.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "fallow": "3.16.0",
    "oxlint": "^1.78.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^7"
  },
  "dependencies": {
    "@alibaba-group/opensandbox": "^0.1.11",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "diff": "^9.0.0",
    "hono": "^4.13.2",
    "lucide-react": "^1.31.0",
    "parse-diff": "^0.12.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  }
}
