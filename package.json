{
  "name": "orchestrator",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:web && bun run server",
    "start": "bun run dev",
    "server": "bun run src/composition/server.ts",
    "orch": "bun run src/orch/cli.ts",
    "build:web": "bun build web/src/main.tsx --outdir web/dist --minify --target browser && tailwindcss -i web/style.css -o web/dist/app.css --minify",
    "perf:budget": "bun run scripts/performance-budget.ts",
    "perf:bench": "bun run scripts/benchmark.ts",
    "test": "bun test --max-concurrency 4",
    "test:coverage": "ORCH_COVERAGE=1 bun test --max-concurrency 4 && bun run test/support/coverage-report.ts",
    "typecheck": "tsc -b --pretty false",
    "typecheck:clean": "tsc -b --clean && tsc -b --pretty false",
    "lint": "oxlint src web/src test",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "audit": "fallow audit",
    "audit:all": "fallow audit --gate all",
    "guard": "fallow guard",
    "audit:fix": "fallow fix --yes --no-create-config --format compact",
    "validate": "bun run format:check && bun run typecheck && bun run lint && bun run build:web && bun run perf:budget && bun run test",
    "test:stress": "bun run scripts/stress-tests.ts",
    "check": "bun run audit && bun run validate"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@biomejs/biome": "^2.5.8",
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "latest",
    "@types/diff": "^8.0.0",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-reports": "^3.0.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "babel-plugin-istanbul": "^8.0.0",
    "fallow": "3.16.0",
    "fast-check": "^4.9.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7"
  },
  "dependencies": {
    "@alibaba-group/opensandbox": "^0.1.11",
    "@hono/zod-validator": "^0.9.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "diff": "^9.0.0",
    "hono": "^4.13.2",
    "lucide-react": "^1.31.0",
    "parse-diff": "^0.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  }
}
