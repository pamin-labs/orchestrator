{
  "name": "orchestrator",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:web && bun run server",
    "start": "bun run dev",
    "server": "bun run src/composition/server.ts",
    "trace:up": "docker compose -f docker/otel-compose.yml up -d",
    "trace:down": "docker compose -f docker/otel-compose.yml down",
    "db:up": "sh -c 'set -a; [ -f .env ] && . ./.env; set +a; exec docker compose -f docker/postgres-compose.yml up -d --wait'",
    "db:down": "sh -c 'set -a; [ -f .env ] && . ./.env; set +a; exec docker compose -f docker/postgres-compose.yml down'",
    "db:generate": "drizzle-kit generate",
    "db:test:up": "docker compose -f docker/postgres-test-compose.yml up -d --wait",
    "db:test:down": "docker compose -f docker/postgres-test-compose.yml down",
    "dev:trace": "OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318 bun run dev",
    "orch": "bun run src/orch/cli.ts",
    "build:web": "bun run scripts/build-web.ts && tailwindcss -i web/style.css -o web/dist/app.css --minify",
    "build:server": "bun run scripts/build-server.ts",
    "perf:budget": "bun run scripts/performance-budget.ts",
    "perf:bench": "bun run scripts/benchmark.ts",
    "embedding:check": "bun run scripts/embedding-check.ts",
    "test": "bun run scripts/test.ts",
    "test:coverage": "rm -rf coverage/parts && ORCH_COVERAGE=1 bun run scripts/test.ts && bun run test/support/coverage-report.ts",
    "typecheck": "tsc -b --pretty false",
    "typecheck:clean": "tsc -b --clean && tsc -b --pretty false",
    "lint": "oxlint src web/src test scripts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "i18n:extract": "lingui extract --config scripts/lingui.config.js --clean && bun run i18n:hant && bun run i18n:progress",
    "i18n:hant": "bun run scripts/i18n-hant.ts",
    "i18n:progress": "bun run scripts/i18n-progress.ts",
    "i18n:validate": "bun run scripts/i18n-validate.ts",
    "i18n:check": "bun run i18n:extract && git diff --exit-code -- locales/ README.md README.zh-CN.md",
    "audit": "FALLOW_AUDIT_BASE=origin/main fallow audit",
    "audit:all": "FALLOW_AUDIT_BASE=origin/main fallow audit --gate all",
    "audit:crap": "bun run test:coverage && bun run audit:all -- --coverage coverage/coverage-final.json",
    "health:gaps": "fallow health --coverage-gaps",
    "audit:fix": "fallow fix --yes --no-create-config --format compact",
    "validate": "bun run format:check && bun run typecheck && bun run lint && bun run build:web && bun run perf:budget && bun run test",
    "test:stress": "bun run scripts/stress-tests.ts",
    "check": "bun run audit && bun run validate",
    "preflight": "bun run scripts/preflight.ts",
    "test:coverage:ci": "rm -rf coverage/parts && ORCH_COVERAGE=1 bun run scripts/test.ts --reporter=junit --reporter-outfile=\"$JUNIT_OUT\" && bun run test/support/coverage-report.ts"
  },
  "devDependencies": {
    "@babel/core": "^8",
    "@biomejs/biome": "^2.6.3",
    "@embedded-postgres/darwin-arm64": "18.4.0-beta.17",
    "@embedded-postgres/darwin-x64": "18.4.0-beta.17",
    "@embedded-postgres/linux-arm64": "18.4.0-beta.17",
    "@embedded-postgres/linux-x64": "18.4.0-beta.17",
    "@happy-dom/global-registrator": "^21.0.4",
    "@lingui/babel-plugin-lingui-macro": "6.10.1",
    "@lingui/cli": "6.10.1",
    "@lingui/conf": "6.10.1",
    "@lingui/format-po": "6.10.1",
    "@opentelemetry/otlp-transformer": "^0.300.0",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "1.4.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.12",
    "@types/diff": "^8.0.0",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-report": "^3.0.3",
    "@types/istanbul-reports": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/stopword": "^2.0.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "drizzle-kit": "1.0.0-rc.4",
    "fallow": "3.37.0",
    "fast-check": "^4.10.2",
    "fishery": "^2.4.0",
    "happy-dom": "^21.0.4",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "msw": "^3.0.3",
    "opencc-js": "^1.4.1",
    "oxc-coverage-instrument": "0.19.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "tempy": "^3.2.0",
    "tinybench": "^6.2.2",
    "typescript": "^7"
  },
  "dependencies": {
    "@alibaba-group/opensandbox": "^1.2.0",
    "@hono/zod-validator": "^0.9.1",
    "@lingui/core": "6.10.1",
    "@lingui/message-utils": "6.10.1",
    "@lingui/react": "6.10.1",
    "@octokit/core": "^7.0.8",
    "@octokit/plugin-retry": "^8.1.1",
    "@octokit/plugin-throttling": "^11.0.5",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.0.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/exporter-prometheus": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "@orama/orama": "^3.1.18",
    "@orama/stemmers": "^3.1.18",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-virtual": "^3.14.23",
    "@uiw/react-md-editor": "^4.1.6",
    "@vscode/tree-sitter-wasm": "0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "commander": "^15.0.0",
    "consola": "^3.4.2",
    "croner": "^11.0.0",
    "d3-flame-graph": "^5.0.0",
    "d3-scale": "4.0.2",
    "defu": "^6.1.7",
    "diff": "^9.0.0",
    "drizzle-orm": "1.0.0-rc.4",
    "eld": "^2.1.0",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.14",
    "lucide-react": "^1.63.0",
    "markdown-it": "^15.0.3",
    "p-map": "^7.1.1",
    "parse-diff": "^0.12.0",
    "promptpurify": "^0.0.1",
    "quick-lru": "^7.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.15.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sonner": "^2.0.8",
    "stopword": "^3.1.5",
    "tailwind-merge": "^3.7.0",
    "unified": "^11.0.5",
    "web-tree-sitter": "0.27.1",
    "zod": "^4.6.7"
  },
  "trustedDependencies": [
    "@embedded-postgres/darwin-arm64",
    "@embedded-postgres/darwin-x64",
    "@embedded-postgres/linux-arm64",
    "@embedded-postgres/linux-x64"
  ]
}
