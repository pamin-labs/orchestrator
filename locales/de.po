msgstr "{rest} weitere von {total}"

msgid "{rest} more requirements"
msgstr "{rest} weitere Anforderungen"

msgid "{role} finished {n, plural, one {# turn} other {# turns}} without changing a file, a task or a note"
msgstr "{role} hat {n, plural, one {# Zug} other {# Züge}} beendet, ohne eine Datei, eine Aufgabe oder eine Notiz anzufassen"

msgid "{role} has rewritten {file} {n, plural, one {# turn} other {# turns}} running — probably a design problem, sending it to the Architect"
msgstr "{role} schreibt {file} seit {n, plural, one {# Zug} other {# Züge}} immer wieder um — vermutlich ein Entwurfsproblem, geht an den Architect"

msgid "{role} wrote {n, plural, one {# file} other {# files}} this group does not own ({files}) — reverted; this CLI's sandbox cannot stop the write, so the check runs after it"
msgstr "{role} hat {n, plural, one {# Datei} other {# Dateien}} geschrieben, die dieser Gruppe nicht gehören ({files}) — zurückgenommen; die Sandbox dieser CLI kann das Schreiben nicht verhindern, deshalb prüft der Abgleich danach"

msgid "{role}'s session record is gone; the next turn starts a new session"
msgstr "der Sitzungsmitschnitt von {role} ist weg; der nächste Zug beginnt mit einer neuen Sitzung"

msgid "{runningCount} running · {total} total"
msgstr "{runningCount} laufen · {total} gesamt"

msgid "{runtime} credential expired"
msgstr "{runtime}-Zugangsdaten abgelaufen"

msgid "{runtime} credentials rejected"
msgstr "{runtime}-Zugangsdaten wurden abgelehnt"

msgid "{server} answers, but it is not a sandbox server (HTTP {status}) — point at another address."
msgstr "{server} antwortet, ist aber kein sandbox server (HTTP {status}) — zeige auf eine andere Adresse."

msgid "{server} does not answer, and it is not an address on this machine — nothing can be started here. Look on that machine."
msgstr "{server} antwortet nicht und ist keine Adresse auf dieser Maschine — hier lässt sich nichts starten. Sieh auf jener Maschine nach."

msgid "{sessionTokens} tokens this session · {model}"
msgstr "{sessionTokens} Tokens diese Sitzung · {model}"

msgid "{skill} is not enabled"
msgstr "{skill} ist nicht aktiviert"

msgid "{spent} / {cap} tokens. Spending it all suspends the whole group."
msgstr "{spent} / {cap} Tokens. Sind sie aufgebraucht, pausiert die ganze Gruppe."

msgid "{staged}/{ticked} ticked reach the sandbox, {fromRepo} from the repository, about {tokens}k tokens of prefix per turn"
msgstr "{staged}/{ticked} angehakt erreichen die Sandbox, {fromRepo} aus dem Repository, etwa {tokens}k Tokens Präfix pro Zug"

msgid "{staged}/{ticked} ticked reach the sandbox, about {tokens}k tokens of prefix per turn"
msgstr "{staged}/{ticked} angehakt erreichen die Sandbox, etwa {tokens}k Tokens Präfix pro Zug"

msgid "{tier} auto-accepted, all three gates passed"
msgstr "{tier} automatisch abgenommen, alle drei Gates bestanden"

msgid "{total} waiting on you"
msgstr "{total} warten auf dich"

