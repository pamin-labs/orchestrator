msgstr "{n, plural, one {# Abschnitt} other {# Abschnitte}}"

msgid "{n, plural, one {# thing needs} other {# things need}} you:"
msgstr "{n, plural, one {# Sache braucht} other {# Dinge brauchen}} dich:"

