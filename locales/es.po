msgid "No other requirements for this project"
msgstr "No hay otros requisitos en este proyecto"

msgid "no owned paths declared, and {holders} already hold theirs — the Architect has to cut the boundary before work starts"
msgstr "no se declararon rutas propias y {holders} ya tienen las suyas: el Arquitecto tiene que cortar la frontera antes de empezar"

msgid "no path"
