msgstr "{groups, plural, one {# requisito} other {# requisitos}} en <0>{repoPath}</0>"

msgid "{groups, plural, one {The one requirement in {repoPath} — its container, cards, records and attachments — is deleted, and cannot be recovered.} other {All # requirements in {repoPath} — their containers, cards, records and attachments — are deleted, and cannot be recovered.}}"
msgstr "{groups, plural, one {El único requisito de {repoPath} — su contenedor, tarjetas, registros y adjuntos — se elimina y no se puede recuperar.} other {Los # requisitos de {repoPath} — sus contenedores, tarjetas, registros y adjuntos — se eliminan y no se pueden recuperar.}}"

msgid "{hard} blocking the whole group"
msgstr "{hard} bloquean todo el grupo"

msgid "{held} stopped"
msgstr "{held} detenidos"

msgid "{hiddenCount} more"
msgstr "{hiddenCount} más"

msgid "{hiddenLines} more lines"
msgstr "{hiddenLines} líneas más"

