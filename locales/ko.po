msgstr "main 에 머지"

msgid "merged into main"
msgstr "main에 병합했습니다"

msgid "Message this group"
msgstr "이 그룹에 메시지"

msgid "Message this group…"
msgstr "이 그룹에 메시지…"

msgid "migrated and queryable"
msgstr "마이그레이션 완료, 조회 가능"

