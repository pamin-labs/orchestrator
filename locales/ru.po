msgstr "Выделено из требования {from}."

msgid "Split out of the requirement {from}. The whole of what was originally asked for is note #{note}."
msgstr "Выделено из требования {from}. Исходная просьба целиком — в заметке #{note}."

msgid "squashed {why}"
msgstr "squash выполнен ({why})"

