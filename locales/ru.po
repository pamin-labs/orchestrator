msgstr "{files} файлов"

msgid "{from} has sent the whole branch back {n} times. That is usually the acceptance criteria rather than the code:\n"
"{why}"
msgstr "{from} возвращает всю ветку уже {n} раз. Обычно дело в критериях приёмки, а не в коде:\n"
"{why}"

