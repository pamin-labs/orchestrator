msgstr "{hitCount} требований хотят те же файлы и не могут идти вместе"

msgid "{hours} hr"
msgstr "{hours} ч"

msgid "{idleCount} more are idle and costing nothing."
msgstr "ещё {idleCount} простаивают и ничего не стоят."

