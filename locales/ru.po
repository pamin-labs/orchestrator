msgstr "{live} выполняется"

msgid "{mine} overlaps {theirs} owned by {name} — wait for it, or ask the Architect for a different split"
msgstr "{mine} пересекается с {theirs}, которым владеет {name} — дождитесь его или попросите Архитектора разделить иначе"

msgid "{minutes} min"
msgstr "{minutes} мин"

msgid "{minutes}m ago"
msgstr "{minutes} мин назад"

msgid "{mode} · {days} days left"
msgstr "{mode} · осталось дней: {days}"

msgid "{mode} · accepted"
msgstr "{mode} · принято"

