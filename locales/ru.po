msgstr "Отправить задачу"

msgid "Subscription"
msgstr "Подписка"

msgid "Swap sessions when context hits this much of the window. Fallback trigger; real rotation is slice-end—clean semantic boundary, cheap handoff."
msgstr "Меняет сессию, когда контекст достигает такой доли окна. Это запасной триггер; настоящая смена происходит в конце среза — чистая смысловая граница и дешёвая передача дел."

msgid "Switch project"
msgstr "Сменить проект"

msgid "Switch requirement"
msgstr "Сменить требование"

msgid "System"
msgstr "Система"

msgid "System timing"
msgstr "Системные тайминги"

