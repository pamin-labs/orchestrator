msgstr "Начать"

msgid "Start Docker Desktop, or run colima start, and wait for it to report running."
msgstr "Запустите Docker Desktop или выполните colima start и дождитесь состояния running."

msgid "Start from this branch"
msgstr "Начать с этой ветки"

msgid "Started"
msgstr "Начато"

msgid "Started at"
msgstr "Начато в"

msgid "Starting…"
msgstr "Запуск…"

