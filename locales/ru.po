msgstr "{groupCount} требований трогают разные файлы и могут идти вместе (ещё {more} без назначения)"

msgid "{groups, plural, one {# requirement} other {# requirements}} in <0>{repoPath}</0>"
msgstr "{groups, plural, one {# требование} few {# требования} many {# требований} other {# требования}} в <0>{repoPath}</0>"

msgid "{groups, plural, one {The one requirement in {repoPath} — its container, cards, records and attachments — is deleted, and cannot be recovered.} other {All # requirements in {repoPath} — their containers, cards, records and attachments — are deleted, and cannot be recovered.}}"
msgstr "{groups, plural, one {Единственное требование в {repoPath} — его контейнер, карточки, записи и вложения — будет удалено безвозвратно.} few {# требования в {repoPath} — их контейнеры, карточки, записи и вложения — будут удалены безвозвратно.} many {# требований в {repoPath} — их контейнеры, карточки, записи и вложения — будут удалены безвозвратно.} other {# требования в {repoPath} — их контейнеры, карточки, записи и вложения — будут удалены безвозвратно.}}"

msgid "{hard} blocking the whole group"
msgstr "{hard} блокируют всю группу"

msgid "{held} stopped"
msgstr "{held} остановлено"

msgid "{hiddenCount} more"
msgstr "ещё {hiddenCount}"

msgid "{hiddenLines} more lines"
msgstr "ещё {hiddenLines} строк"

