msgstr "{groups, plural, one {# exigence} other {# exigences}} dans <0>{repoPath}</0>"

msgid "{groups, plural, one {The one requirement in {repoPath} — its container, cards, records and attachments — is deleted, and cannot be recovered.} other {All # requirements in {repoPath} — their containers, cards, records and attachments — are deleted, and cannot be recovered.}}"
msgstr "{groups, plural, one {L'unique exigence de {repoPath} — son conteneur, ses cartes, ses enregistrements et ses pièces jointes — est supprimée, sans retour possible.} other {Les # exigences de {repoPath} — leurs conteneurs, cartes, enregistrements et pièces jointes — sont supprimées, sans retour possible.}}"

msgid "{hard} blocking the whole group"
msgstr "{hard} bloquent tout le groupe"

msgid "{held} stopped"
msgstr "{held} arrêtées"

