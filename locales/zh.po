msgid "…and say which file is untested"
msgstr "……并指出哪个文件没被测到"

msgid "'Do you still accept this credential': GitHub's /user, a provider's /v1/models. Short because a slow answer reports 'not verified' rather than failing, and nothing waits on it."
msgstr "「你还认这个凭据吗」：GitHub 的 /user、供应商的 /v1/models。比上面的 API 调用短，因为答案慢只会报「未验证」而不是失败，没有东西在等它。"

msgid "({deliveredCount})"
msgstr "（{deliveredCount} 个）"

msgid "(following)"
msgstr "（跟随）"

msgid "(need one merge first)"
msgstr "（合入一个才有）"

msgid "(no reply was left)"
msgstr "（没有留下答复）"

#. placeholder {0}: failing.length
msgid "{0, plural, one {# host check failed} other {# host checks failed}}"
msgstr "{0, plural, other {# 项主机检查未通过}}"

msgid "{a} and {b} both hold paths matching {hit} — one of them widened its boundary after starting"
msgstr "{a} 和 {b} 都持有匹配 {hit} 的路径 —— 其中一个在开工后放宽了自己的边界"

msgid "{accountName}, but the App is not installed on any account yet"
msgstr "{accountName}，但 App 还没装到任何账号上"

msgid "{base} moved to {sha}; {name} is behind it and has been told to rebase first"
msgstr "{base} 动到了 {sha}，{name} 的基线落后了，已经让它先 rebase"

msgid "{branch} (per the remote)"
msgstr "{branch}（远端说的）"

msgid "{by} passed this up, with no reason given"
msgstr "{by} 往上递了，没给原因"

msgid "{by} passed this up: {why}"
msgstr "{by} 往上递了：{why}"

msgid "{config} covers all {count} paths to be mounted"
msgstr "{config} 覆盖了要挂载的全部 {count} 个路径"

msgid "{config} does not list {missing}"
msgstr "{config} 里没列出 {missing}"

msgid "{count} repositories"
msgstr "{count} 个仓库"

msgid "{count} repositories, most recently touched first"
msgstr "{count} 个仓库，最近动过的在前"

msgid "{count} selected"
msgstr "选了 {count} 个"

msgid "{count} staged at {path}"
msgstr "{path} 下备好了 {count} 个"

msgid "{count} tickets have no boundary right now: {bareNames}."
msgstr "目前 {count} 个工单没有边界：{bareNames}。"

msgid "{d} days ago"
msgstr "{d} 天前"

msgid "{d}d{hoursLeft}h"
msgstr "{d}天{hoursLeft}小时"

msgid "{failed} failed"
msgstr "{failed} 失败"

msgid "{fails} failed"
msgstr "{fails} 条没过"

msgid "{files} files"
msgstr "{files} 个文件"

msgid "{from} has sent the whole branch back {n} times. That is usually the acceptance criteria rather than the code:\n"
"{why}"
msgstr "整个分支被 {from} 打回 {n} 次了。多半是验收口径本身有问题，不是代码：\n"
"{why}"

msgid "{gates} pass"
msgstr "{gates} 通过"

msgid "{good}"
msgstr "{good}"

msgid "{good} (also has {stale} — check [egress] image)"
msgstr "{good}（另外还有 {stale} —— 检查一下 [egress] image）"

msgid "{group}: {question}"
msgstr "{group}：{question}"

msgid "{groupCount} tickets touch different files and can run together"
msgstr "{groupCount} 个工单各改各的，可以一起跑"

msgid "{groupCount} tickets touch different files and can run together ({more} more not yet assigned)"
msgstr "{groupCount} 个工单各改各的，可以一起跑（还有 {more} 个没分）"

msgid "{groups, plural, one {# ticket} other {# tickets}} in <0>{repoPath}</0>"
msgstr "<0>{repoPath}</0> 的 {groups, plural, other {# 个工单}}"

msgid "{groups, plural, one {The one ticket in {repoPath} — its container, cards, records and attachments — is deleted, and cannot be recovered.} other {All # tickets in {repoPath} — their containers, cards, records and attachments — are deleted, and cannot be recovered.}}"
msgstr "{groups, plural, other {{repoPath} 的 # 个工单——连同它们的容器、卡片、记录和附件——都会被删除，且无法恢复。}}"

msgid "{hard} blocking the whole group"
msgstr "{hard} 条卡着全组"

msgid "{held} stopped"
msgstr "{held} 个停着"

msgid "{hiddenCount} more"
msgstr "还有 {hiddenCount} 条"

msgid "{hiddenLines} more lines"
msgstr "还有 {hiddenLines} 行"

msgid "{hint} stored; paste a new one to replace it"
msgstr "已存 {hint}，粘新的就换掉"

msgid "{hitCount} tickets want the same files and cannot run together"
msgstr "{hitCount} 个工单想改同一批文件，不能一起跑"

msgid "{hours} hr"
msgstr "{hours} 小时"

msgid "{idleCount} more are idle and costing nothing."
msgstr "另外 {idleCount} 个空闲，没在花钱。"

msgid "{image} is neither an image we publish nor one built on this machine"
msgstr "{image} 既不是我们发布的映像，也不是这台机器上构建的"

msgid "{image} is not on this machine"
msgstr "这台机器上没有 {image}"

msgid "{lines} lines"
msgstr "{lines} 行"

msgid "{live} running"
msgstr "{live} 个在跑"

msgid "{mine} overlaps {theirs} owned by {name} — wait for it, or ask the Architect for a different split"
msgstr "{mine} 和 {name} 持有的 {theirs} 重叠了——等它，或者找架构师重新切分"

msgid "{minutes} min"
msgstr "{minutes} 分钟"

msgid "{minutes}m ago"
msgstr "{minutes} 分钟前"

msgid "{mode} · {days} days left"
msgstr "{mode} · 还剩 {days} 天"

msgid "{mode} · accepted"
msgstr "{mode} · 通过"

msgid "{mode} · expired — sign in again"
msgstr "{mode} · 过期了 —— 重新登录"

msgid "{mode} · expires within a day"
msgstr "{mode} · 一天之内就过期"

msgid "{mode} · GitHub no longer accepts this token"
msgstr "{mode} · GitHub 已经不认这个 token 了"

msgid "{mode} · not verified (HTTP {status})"
msgstr "{mode} · 没验上（HTTP {status}）"

msgid "{mode} · stored"
msgstr "{mode} · 已存"

msgid "{mode} · the provider rejected this credential"
msgstr "{mode} · 供应商不认这个凭据"

msgid "{mode} · unreachable, not verified"
msgstr "{mode} · 连不上，没验"

msgid "{months} months ago"
msgstr "{months} 个月前"

msgid "{mount} read-only"
msgstr "{mount} 只读"

msgid "{n, plural, one {# slice} other {# slices}}"
msgstr "{n} 片"

msgid "{n, plural, one {# thing is} other {# things are}} waiting on you ({blocking} blocking):\n"
"{lines}"
msgstr "{n, plural, other {# 件事}}在等你（{blocking} 件卡住了）：\n"
"{lines}"

msgid "{n, plural, one {# thing is} other {# things are}} waiting on you:\n"
"{lines}"
msgstr "{n, plural, other {# 件事}}在等你：\n"
"{lines}"

msgid "{n, plural, one {# thing needs} other {# things need}} you:"
msgstr "有 {n} 件事等你："

msgid "{n} more queued behind it"
msgstr "后面还排着 {n} 个"

msgid "{n} slice(s) · {tokens} tokens · journals in {path}"
msgstr "{n} 个切片 · {tokens} tokens · 工作日志在 {path}"

msgid "{n} to do"
msgstr "{n} 件待办"

msgid "{n} unread — the Librarian is compressing them"
msgstr "未读 {n} 条，已让 Librarian 压成摘要"

msgid "{name} ({repo} · {branch}) has been added. The gates and the install command are guessed once the first group has cloned; fill them in now instead under Settings → Gates."
msgstr "{name}（{repo} · {branch}）加好了。闸门和安装命令等第一个组克隆完再猜，现在填也行：设置 → 闸门。"

msgid "{name} ({repo}, on whatever the remote calls its default branch) has been added. The gates and the install command are guessed once the first group has cloned; fill them in now instead under Settings → Gates."
msgstr "{name}（{repo} · 远端自己的默认分支）加好了。闸门和安装命令等第一个组克隆完再猜，现在填也行：设置 → 闸门。"

msgid "{name} dissolved; its sandbox is reclaimed"
msgstr "{name} 解散了，沙箱回收"

msgid "{name} has been parked {hours}h — wake it, or drop it?"
msgstr "{name} 封存了 {hours} 小时，唤醒还是不做了？"

msgid "{name} has been running with nothing happening for {n, plural, one {# minute} other {# minutes}} and nobody is waiting on an answer"
msgstr "{name} 已经 {n, plural, other {# 分钟}} 没有任何动静，也没有人在等答复"

msgid "{name} has been waiting {min} min for you"
msgstr "{name} 已经等你 {min} 分钟"

msgid "{name} has spent all {tokens} of its tokens and the whole group is suspended. Raise the cap and it carries on, or leave it stopped here."
msgstr "{name} 用完了 {tokens} tokens，全组已挂起。提高上限它就接着跑，或者就让它停在这里。"

msgid "{name} is at {pct}% of its budget"
msgstr "{name} 预算用到 {pct}%"

msgid "{name} is blocked by {path}, which is inside your boundary: {why}"
msgstr "{name} 被 {path} 挡住了，那是你们的路径：{why}"

msgid "{name} is no longer waiting on anything — woken up"
msgstr "{name} 等的那件事已经了结，自动唤醒"

msgid "{name} is over 25MB"
msgstr "{name} 超过 25MB"

msgid "{name} leaves the board and every queued turn is cancelled. The code and the record are both kept."
msgstr "{name} 会从看板上消失，排队的 turn 全部取消。代码和记录都留着。"

msgid "{name} leaves the board and every queued turn is cancelled. The code and the record are kept; the group is never started again."
msgstr "{name} 会从看板上消失，排队的 turn 全部取消。代码和记录留着，组不会再被拉起。"

msgid "{name} parked after waiting {min} min — checkout kept, slot freed"
msgstr "{name} 等你 {min} 分钟后自动封存 —— 代码留着，并发槽释放了"

msgid "{name} produced no output."
msgstr "{name} 没有输出。"

msgid "{name} reached PR, so the question still hanging on it expired — closed by itself"
msgstr "{name} 已经走到 PR，那条还挂着的问题过期了，自动关掉"

msgid "{name} S{seq} has been waiting {hours}h for you"
msgstr "{name} S{seq} 等你查收 {hours} 小时了"

msgid "{name} spent its whole budget ({tokens} tokens) and is suspended"
msgstr "{name} 把 {tokens} tokens 花完了，全组挂起"

msgid "{name}: {n, plural, one {# running turn was} other {# running turns were}} killed before the data goes"
msgstr "{name}：{n, plural, other {# 个在跑的 turn}} 先掐掉了，再删数据"

msgid "{name}: PR #{pr} was closed — reopen it or drop the ticket"
msgstr "{name}：PR #{pr} 被关了 —— 重开，或者这个工单不做了"

msgid "{name}: the PR will not open — {why}"
msgstr "{name}：PR 开不出来 —— {why}"

msgid "{name}'s container is discarded and the next turn rebuilds it: re-clone the branch, reinstall dependencies. Uncommitted changes are lost."
msgstr "{name} 的容器会被扔掉，下一个 turn 重建：重新 clone 分支、重装依赖。没提交的改动会丢。"

msgid "{name}'s plan card has been waiting {hours}h for you"
msgstr "{name} 的计划卡等你批 {hours} 小时了"

msgid "{name}'s PR has been at the head of the merge queue for {hours}h"
msgstr "{name} 的 PR 排在队首 {hours} 小时了"

msgid "{name}'s PR has been at the head of the merge queue for {hours}h, with {n} behind it"
msgstr "{name} 的 PR 排在队首 {hours} 小时了，后面还堵着 {n} 个"

msgid "{name}'s sandbox is bound to a superseded credential; reclaimed, and the next tick rebuilds it"
msgstr "{name} 的沙箱绑的是旧凭据，回收了，下一轮重建"

msgid "{path} is a path inside this container, and the mount is made by the sandbox server's docker, which resolves it on its own filesystem. Use one absolute path on both sides (-v <host path>:{path}) and add it to the sandbox server's allowed_host_paths. A mismatch does not fail; it mounts an empty directory."
msgstr "{path} 是这个容器里的路径，而挂载是沙箱服务器的 docker 做的，它在自己的文件系统上解析这个路径。两边用同一个绝对路径（-v <host path>:{path}），并把它加进沙箱服务器的 allowed_host_paths。对不上不会报错，只会挂上一个空目录。"

msgid "{path} is back to its default"
msgstr "{path} 恢复默认了"

msgid "{path} is now {value}"
msgstr "{path} 改成了 {value}"

msgid "{path}: {error}"
msgstr "{path}：{error}"

msgid "{path}: cannot be read"
msgstr "{path}：读不了"

msgid "{repo} has been added, but this login cannot push to it: {why}. Deal with it now, rather than after the first slice is finished."
msgstr "{repo} 加好了，但这个登录推不上去：{why}。现在处理，别等第一个切片做完。"

msgid "{repo}'s own skills are not listed yet: the code only exists inside a container, so nothing can count them until the first group has cloned it (we look in {dirs}). After that they appear here by themselves, and you can name one in the composer with /name. Skills kept outside those directories are invisible to both."
msgstr "{repo} 自带的技能还没列出来 —— 代码只在容器里，得等第一个组克隆完才数得清（找的是 {dirs}）。那之后它们会自动出现在这里，也能在输入框里 /名字 点名。技能放在这几个目录之外的话，两边都看不到。"

msgid "{repoPath} is already registered as \"{name}\""
msgstr "{repoPath} 已经注册为「{name}」"

msgid "{repoPath} removed"
msgstr "{repoPath} 已删除"

msgid "{resource} failed {n}x with no code change in between — treat the environment as the suspect"
msgstr "{resource} 失败 {n} 次而代码没变 —— 先怀疑环境，别再改代码"

msgid "{resource} is failing in {n, plural, one {# group} other {# different groups}} — likely the project, not the groups"
msgstr "{resource} 在 {n, plural, other {# 个不同的工单}} 里都在失败 —— 多半是项目的问题，不是这些工单的问题"

msgid "{rest} more of {total}"
msgstr "还有 {rest} 个（共 {total}）"

msgctxt "notes"
msgid "{rest} more of {total}"
msgstr "还有 {rest} 条（共 {total}）"

msgid "{rest} more tickets"
msgstr "还有 {rest} 条工单"

msgid "{role} finished {n, plural, one {# turn} other {# turns}} without changing a file, a task or a note"
msgstr "{role} 连续 {n} 个 turn 没动过文件、任务或记录"

msgid "{role} has rewritten {file} {n, plural, one {# turn} other {# turns}} running — probably a design problem, sending it to the Architect"
msgstr "{role} 连着 {n} 个 turn 在改同一个文件 {file} —— 大概是设计问题，转给 Architect"

msgid "{role} wrote {n, plural, one {# file} other {# files}} this group does not own ({files}) — reverted; this CLI's sandbox cannot stop the write, so the check runs after it"
msgstr "{role} 改了本组不拥有的 {n} 个文件（{files}），已回滚 —— 这个 CLI 的沙箱拦不住写入，只能事后对账"

msgid "{role}'s session record is gone; the next turn starts a new session"
msgstr "{role} 的会话记录没了，下一轮从新会话开始"

msgid "{runningCount} running · {total} total"
msgstr "在跑 {runningCount} · 共 {total}"

msgid "{runtime} credential expired"
msgstr "{runtime} 凭据过期"

msgid "{runtime} credentials rejected"
msgstr "{runtime} 的凭据被拒了"

msgid "{server} answers, but it is not a sandbox server (HTTP {status}) — point at another address."
msgstr "{server} 有应答，但它不是 sandbox server（HTTP {status}）——换个地址。"

msgid "{server} does not answer, and it is not an address on this machine — nothing can be started here. Look on that machine."
msgstr "{server} 没有应答，而且它不是这台机器上的地址——这里起不了。去那台机器上看。"

msgid "{sessionTokens} tokens this session · {model}"
msgstr "本 session {sessionTokens} tokens · {model}"

msgid "{skill} is not enabled"
msgstr "{skill} 没启用"

msgid "{spent} / {cap} tokens. Spending it all suspends the whole group."
msgstr "{spent} / {cap} tokens。用满即挂起全组。"

msgid "{staged}/{ticked} ticked reach the sandbox, {fromRepo} from the repository, about {tokens}k tokens of prefix per turn"
msgstr "勾中的 {staged}/{ticked} 个进沙箱，仓库自带 {fromRepo} 个，每 turn 前缀约 {tokens}k tokens"

msgid "{staged}/{ticked} ticked reach the sandbox, about {tokens}k tokens of prefix per turn"
msgstr "勾中的 {staged}/{ticked} 个进沙箱，每 turn 前缀约 {tokens}k tokens"

msgid "{tier} auto-accepted, all three gates passed"
msgstr "{tier} 自动查收，三道闸全过"

msgid "{total} waiting on you"
msgstr "{total} 条等你"

msgid "{waiting, plural, one {# slice awaiting acceptance} other {# slices awaiting acceptance}}"
msgstr "{waiting} 片待查收"

msgid "{waiting} to do"
msgstr "{waiting} 件待办"

msgid "{who} is hanging on your answer"
msgstr "{who} 挂着等你答"

msgid "{who} objected after the fact"
msgstr "{who} 后补反对"

msgid "{width} per bucket"
msgstr "每格 {width}"

msgid "← Back to all"
msgstr "← 回到全部"

msgid "← Back to full timeline"
msgstr "← 回到整段时间"

msgid "+ Add project"
msgstr "＋ 添加项目"

msgid "+ New ticket"
msgstr "＋ 新工单"

msgid "1/4 of host cores"
msgstr "宿主核数的 1/4"

msgid "127.0.0.1:8080 or https://host:port"
msgstr "127.0.0.1:8080 或 https://host:port"

msgid "A background task crashed and the server carried on without it. That is a bug — please send this to whoever maintains it:\n"
"{stack}"
msgstr "有个后台任务崩了，服务没跟着退出。这是个 bug，请把这段贴给开发：\n"
"{stack}"

msgid "A number"
msgstr "要一个数字"

msgid "A paused group is waiting on you and costs a concurrency slot while it waits. This is how often it says so before 'Archive after paused' takes the slot back."
msgstr "暂停的组在等你，等的时候还占着一个并发位。这是它多久说一次，直到「暂停多久后封存」把位子收回去。"

msgid "A project's config has to be a JSON object. One partial edit will not be allowed to replace the whole of it."
msgstr "项目配置必须是一个 JSON 对象；拒绝用一次局部修改覆盖整份配置。"

msgid "Abandon this ticket"
msgstr "作废这个工单"

msgid "Abandoned"
msgstr "作废"

msgid "Accept"
msgstr "查收"

msgid "acceptance"
msgstr "验收"

msgid "Acceptance criteria"
msgstr "验收口径"

msgid "accepted {done}/{total}"
msgstr "已查收 {done}/{total}"

msgid "accepted: S{seq} {title}"
msgstr "查收 S{seq} {title}"

msgid "accepted: S{seq} {title} ({why})"
msgstr "查收 S{seq} {title}（{why}）"

msgid "Active turns will stop; containers, slices, cards, questions, attachments deleted and unrecoverable"
msgstr "在跑的 turn 会停，容器、切片、卡片、提问、附件一起删，找不回来"

msgid "Add"
msgstr "加进来"

msgid "Add · {branch}"
msgstr "添加 · {branch}"

msgid "Add {path} to the sandbox server's allowed_host_paths, or every group fails to open a container. Tick the skills in Settings."
msgstr "把 {path} 加进沙箱服务器的 allowed_host_paths，否则每个组都开不出容器。技能在设置里勾。"

msgid "Add a row"
msgstr "加一项"

msgid "Add a step"
msgstr "加一级"

msgid "Add another"
msgstr "再加一个"

msgid "Add tickets or explain why you're rejecting. Paste screenshots or designs; / to insert a skill. Cmd+Enter to request changes"
msgstr "补充要求，或者写退回理由。截图、设计稿直接粘，/ 插技能路径。⌘Enter 要求修改"

msgid "Add your first project"
msgstr "添加第一个项目"

msgid "Added"
msgstr "已添加"

msgid "Adding…"
msgstr "添加中…"

msgid "Address"
msgstr "地址"

msgid "After a green gate, put the slice's source back and run the tests again: still green means they prove nothing. Costs one extra test run on a slice that changed both code and tests."
msgstr "门禁通过之后，把这个切片的源码改动还原再跑一次测试：还是绿的，就说明它什么都没证明。代价是在同时改了代码和测试的切片上多跑一次测试。"

msgid "After a slice fails several times straight, escalate to a person instead of retrying the same path."
msgstr "同一片连着几次没过就升级给人，而不是一直重试同一条路。"

msgid "After approval, copy the code from that page"
msgstr "批准完那一页会给一串码，贴这儿"

msgid "AI is thinking on your behalf"
msgstr "AI 在替你想"

msgid "AI-drafted response"
msgstr "AI 替你拟的答复"

msgid "All"
msgstr "全部"

msgid "All done"
msgstr "都做完了"

msgid "All pass"
msgstr "全过"

msgid "all under {ceiling}"
msgstr "都在 {ceiling} 以内"

msgid "all under 1ms"
msgstr "都在 1ms 以内"

msgid "Allow notifications"
msgstr "允许通知"

msgid "already spent {spent} tokens — a cap at {tokens} would stop it again immediately"
msgstr "已经花掉 {spent} tokens —— 上限设成 {tokens} 会立刻再停一次"

msgid "already spent {tokens} tokens"
msgstr "已经花了 {tokens} tokens"

msgid "also changed on S{seq}, unclaimed: {files}"
msgstr "S{seq} 还改了这些但没声明：{files}"

msgid "An image has to be one we publish (ghcr.io/pamin-labs/…) or one you built locally (orch/agent:1, say). The agent runs inside this image with your code in front of it, so pointing it somewhere else hands over the whole boundary — and nothing on the panel would show it."
msgstr "镜像只能是我们发布的（ghcr.io/pamin-labs/…）或者你本地构建的（比如 orch/agent:1）。agent 在这个镜像里跑，而它面前是你的代码 —— 换成别处的镜像等于把整条边界交出去，而且从面板上看不出来。"

msgid "An unfinished turn is wasted; the group restarts its container and carries on by itself. Code and branches are unaffected."
msgstr "没跑完的 turn 就白跑了，组会自己重开容器接着做，代码和分支不受影响。"

msgid "answer revoked, but the rollback to {sha} failed: {why}"
msgstr "答复已撤销，但回滚到 {sha} 失败了：{why}"

msgid "Answered on your behalf"
msgstr "替你答过"

msgid "answered on your behalf by {who}"
msgstr "{who} 代答"

msgid "API address"
msgstr "API 地址"

msgid "API key"
msgstr "API 密钥"

msgid "Appearance"
msgstr "外观"

msgid "Approval recorded — it starts by itself once the boundary clears."
msgstr "已记下批准 —— 边界一让开它就自己开工。"

msgid "Approve and start"
msgstr "批准开工"

msgid "Approved · Awaiting boundary"
msgstr "已批·等边界"

msgid "Approved, blocked by boundaries"
msgstr "已批准，边界挡着"

msgid "Approved; starts automatically when boundaries clear"
msgstr "已批准，边界让开就自动开工"

